{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Corto Developer Console",
  "colors": {
    "primary": "#311B9B",
    "light": "#ECE9F5",
    "dark": "#2F1A75"
  },
  "favicon": {
    "light": "/images/corto.svg",
    "dark": "/images/corto.svg"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Applications",
        "pages": [
          "auth/apps/frontend",
          "auth/apps/backend",
          "auth/apps/mcp"
        ]
      },
      {
        "group": "Admin",
        "pages": [
          "for-admins"
        ]
      },
      "test-accounts",
      "marketplace",
      "auth/troubleshooting"
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Corto Public API",
          "href": "https://docs.docorto.ai/"
        },
        {
          "anchor": "Corto Help Centre",
          "href": "https://help.docorto.ai/en/collections/11811763-getting-started"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/corto.svg",
    "dark": "/images/corto.svg",
    "href": "https://www.docorto.ai/"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@docorto.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://au.linkedin.com/company/docorto"
    }
  },
  "appearance": {
    "default": "light"
  },
  "fonts": {
    "family": "Roboto"
  }
}
