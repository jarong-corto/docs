{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Corto Developer Console",
  "colors": {
    "primary": "#311B9B",
    "light": "#ECE9F5",
    "dark": "#2F1A75"
  },
  "favicon": {
    "light": "/images/corto.svg",
    "dark": "/images/corto.svg"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart",
          "auth/troubleshooting"
        ]
      },
      {
        "group": "Applications",
        "pages": [
          "auth/apps/frontend",
          "auth/apps/backend",
          "auth/apps/mcp"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/corto.svg",
    "dark": "/images/corto.svg",
    "href": "https://www.docorto.ai/"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  },
  "appearance": {
    "default": "light"
  },
  "fonts": {
    "family": "Roboto"
  }
}
